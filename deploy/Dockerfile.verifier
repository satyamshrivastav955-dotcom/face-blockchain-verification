# The static, client-side verifier. No server-side logic: it only serves files.
#
#   docker build -f deploy/Dockerfile.verifier -t faceproof-verifier .
#   docker run --rm -p 127.0.0.1:8080:8080 faceproof-verifier

FROM node:24-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm test && npm run build:verifier

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/nginx.verifier.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist-verifier /usr/share/nginx/html
EXPOSE 8080
