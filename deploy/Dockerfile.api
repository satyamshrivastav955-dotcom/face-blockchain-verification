# FaceProof local API + UI as a container.
#
# The app has NO authentication. Publish the port on loopback only (see docker-compose.yml), put your own
# authenticating reverse proxy in front of it, or do not run it on a shared network.
#
#   docker build -f deploy/Dockerfile.api -t faceproof-api .
#   docker run --rm -p 127.0.0.1:8765:8765 -v faceproof-data:/data faceproof-api

FROM node:24-alpine AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build && npm run build:verifier

FROM python:3.13-slim AS app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PROJECT_DIR=/data
WORKDIR /app
# opencv-python (non-headless) needs these shared libraries, which python:slim does not ship.
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libxcb1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-web.txt constraints.txt ./
# constraints.txt was resolved on Windows: drop the platform-specific pins before using it on Linux.
RUN grep -viE '^(eth-tester|py-evm|lru-dict|pywin32|colorama)==' constraints.txt > /tmp/constraints.txt \
 && pip install -r requirements-web.txt -c /tmp/constraints.txt
COPY src ./src
COPY contracts ./contracts
COPY tests/data ./tests/data
COPY scripts/fetch_models.py scripts/fetch_insightface.py ./scripts/
COPY --from=web /web/dist ./web/dist
COPY --from=web /web/dist-verifier ./web/dist-verifier
RUN useradd --create-home --uid 10001 faceproof && mkdir -p /data && chown faceproof /data
USER faceproof
VOLUME ["/data"]
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8765/api/health', timeout=4)"
# 0.0.0.0 is the container's own interface; the host-side publish decides who can reach it.
CMD ["python", "-m", "src.web", "--host", "0.0.0.0", "--port", "8765"]
