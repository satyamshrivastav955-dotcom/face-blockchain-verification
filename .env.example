# =============================================================
#  Copy to .env and fill in.  NEVER commit .env.
#  During the screen recording, do NOT open this file on camera.
# =============================================================

# ---------- Reverse image search ----------
# Which provider to use: serpapi_lens | tineye | local_fixture
# local_fixture is for OFFLINE DEVELOPMENT ONLY and must not be used
# for the graded run - it reads candidates from a local JSON file.
SEARCH_PROVIDER=serpapi_lens

# SerpApi (Google Lens engine). https://serpapi.com/manage-api-key
SERPAPI_KEY=

# TinEye API. https://services.tineye.com/
TINEYE_API_KEY=

# Candidate JSON for the local_fixture provider (development only).
# Equivalent to --fixture. See tests/data/README.md.
FIXTURE_PATH=

# ---------- Image publishing (PRIVACY) ----------
# Google Lens needs the query image reachable at a PUBLIC URL. Uploading it to a
# public host is an externally visible action: it only happens when you pass
# --consent-public-upload AND this is not "none". Default: none (never upload).
# Options: none | catbox | uguu | imgbb. With "none", host the image yourself and
# pass --image-url. External search itself needs --consent-external-search.
PUBLISH_PROVIDER=none
IMGBB_API_KEY=

# ---------- Blockchain (Base Sepolia by default; any EVM chain works) ----------
CHAIN_NAME=base-sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
EXPLORER_BASE=https://sepolia.basescan.org

# Burner wallet ONLY. Fund from a Base Sepolia faucet.
# This key should control nothing of value.
PRIVATE_KEY=

# Address of a registry INTERFACE v2 deployment (see docs/DEPLOYMENT.md). An older v1
# deployment is detected and rejected. Nothing is deployed for you automatically.
CONTRACT_ADDRESS=

# ---------- Thresholds ----------
# 0.363 is the cosine cut-off in OpenCV's SFace example. It is NOT a universal
# constant: it depends on the model and your data (see docs/EVALUATION.md).
FACE_COSINE_THRESHOLD=0.363
# Max perceptual-hash Hamming distance (0-64) to call two images near-identical.
PHASH_MAX_DISTANCE=12
# Max candidates from the search provider to actually download and confirm.
MAX_CANDIDATES=25

# ---------- Local evidence retention ----------
# Default age (days) for `purge-evidence`. 0 = no default; nothing is ever deleted
# automatically.
EVIDENCE_RETENTION_DAYS=0

# ---------- Paths (optional) ----------
# Where models/, output/ and evidence/ live. Defaults to the repository root.
# Set this to keep generated artefacts outside the source tree.
PROJECT_DIR=
