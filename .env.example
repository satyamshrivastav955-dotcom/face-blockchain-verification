# =============================================================
#  Copy to .env and fill in.  NEVER commit .env.
#  During the screen recording, do NOT open this file on camera.
# =============================================================

# ---------- Reverse image search ----------
# Which provider to use: serpapi_lens | tineye | local_fixture
# local_fixture is for OFFLINE DEVELOPMENT ONLY and must not be used
# for the graded run - it reads candidates from a local JSON file.
SEARCH_PROVIDER=serpapi_lens

# SerpApi (Google Lens engine). https://serpapi.com/manage-api-key
SERPAPI_KEY=

# TinEye API. https://services.tineye.com/
TINEYE_API_KEY=

# Candidate JSON for the local_fixture provider (development only).
# Equivalent to --fixture. See tests/data/README.md.
FIXTURE_PATH=

# ---------- Image publishing ----------
# Google Lens needs the query image reachable at a PUBLIC URL.
# Options: imgbb | catbox | none
# Use "none" together with --image-url if you host the image yourself.
PUBLISH_PROVIDER=catbox
IMGBB_API_KEY=

# ---------- Blockchain (Base Sepolia) ----------
CHAIN_NAME=base-sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
EXPLORER_BASE=https://sepolia.basescan.org

# Burner wallet ONLY. Fund from a Base Sepolia faucet.
# This key should control nothing of value.
PRIVATE_KEY=

# Filled in after `python -m src.main deploy`
CONTRACT_ADDRESS=

# ---------- Thresholds ----------
# OpenCV SFace documented cosine threshold for "same identity" is 0.363.
FACE_COSINE_THRESHOLD=0.363
# Max perceptual-hash Hamming distance (0-64) to call two images near-identical.
PHASH_MAX_DISTANCE=12
# Max candidates from the search provider to actually download and confirm.
MAX_CANDIDATES=25

# ---------- Paths (optional) ----------
# Where models/, output/ and evidence/ live. Defaults to the repository root.
# Set this to keep generated artefacts outside the source tree.
PROJECT_DIR=
